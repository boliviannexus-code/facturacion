APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/La_Paz
APP_PORT=80
VITE_PORT=5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Estos hosts se resuelven dentro de la red de Sail.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=facturacion
DB_USERNAME=sail
DB_PASSWORD=password
DB_TIMEZONE=America/La_Paz
FORWARD_DB_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Monitoreo y alertas de contingencias SIAT
SIAT_COMMUNICATION_TIMEOUT=5
SIAT_CONTINGENCY_FAILURE_THRESHOLD=3
SIAT_HEALTH_JOB_UNIQUE_SECONDS=60
# Deben coincidir con el catalogo de eventos significativos vigente de la empresa.
SIAT_INTERNET_OUTAGE_EVENT_CODE=1
SIAT_UNAVAILABLE_EVENT_CODE=2
SIAT_EVENT_CLAIM_TTL_MINUTES=5
SIAT_PACKAGE_CLAIM_TTL_MINUTES=5
SIAT_MONITORING_QUEUE=siat-monitoring
SIAT_MONITORING_LOCK_SECONDS=300
SIAT_MONITORING_JOB_UNIQUE_SECONDS=300
SIAT_ALERT_MAX_ATTEMPTS=3
SIAT_ALERT_INTERNAL=true
SIAT_ALERT_MAIL=false
SIAT_ALERT_PANEL=true
SIAT_ALERT_TECHNICAL_LOG=true
SIAT_CUFD_WARNING_MINUTES=120
SIAT_CERTIFICATE_WARNING_DAYS=30
SIAT_CAFC_REMAINING_WARNING=20
SIAT_REGULARIZATION_WARNING_MINUTES=120
SIAT_SCHEDULE_COMMUNICATION="*/2 * * * *"
SIAT_SCHEDULE_RECOVERY="* * * * *"
SIAT_SCHEDULE_EVENT_REGISTRATION="*/2 * * * *"
SIAT_SCHEDULE_BUILD_PACKAGES="*/2 * * * *"
SIAT_SCHEDULE_SEND_PACKAGES="* * * * *"
SIAT_SCHEDULE_PACKAGE_VALIDATION="*/5 * * * *"
SIAT_SCHEDULE_RETRIES="*/5 * * * *"
SIAT_SCHEDULE_DEADLINES="*/10 * * * *"
SIAT_SCHEDULE_CERTIFICATES="0 6 * * *"
SIAT_SCHEDULE_CUFD="*/10 * * * *"
SIAT_SCHEDULE_CAFC="0 * * * *"
SIAT_SCHEDULE_ALERTS="* * * * *"
